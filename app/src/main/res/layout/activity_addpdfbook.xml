<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/darkergreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
 tools:context=".AddPdfBook">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="start"
    android:padding="10dp">
    <include layout="@layout/toolbar"/>

    <ImageView
        android:id="@+id/ivpdfaddPicture"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:scaleType="center"
        android:src="@drawable/ic_add" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter a name for the book"
        android:textColor="@color/white"
        android:layout_marginVertical="10dp"
        android:textSize="20sp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/etpdfSetName"
        android:inputType="text"
        android:maxLength="30"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Write some description: "
        android:textColor="@color/white"

        android:layout_marginVertical="10dp"
        android:textSize="20sp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:id="@+id/etpdfsetDesc"
        android:inputType="textMultiLine"
        android:maxLength="200"
        android:textColor="@color/white"
        android:maxLines="5"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pick relevant genres:"
        android:layout_marginVertical="10dp"
        android:textColor="@color/white"

        android:textSize="20sp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/cbThriller"
                android:textColor="@color/white"

                android:layout_alignParentStart="true"
                android:text="Thriller"/>
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/cbThriller"
                android:id="@+id/cbInformative"
                android:textColor="@color/white"

                android:text="Informative"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"

                android:layout_toRightOf="@id/cbInformative"
                android:id="@+id/cbHorror"
                android:text="Horror"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/cbHorror"
                android:id="@+id/cbDrama"
                android:textColor="@color/white"

                android:text="Drama"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cbThriller"
                android:textColor="@color/white"
                android:id="@+id/cbFantasy"
                android:text="Fantasy"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_below="@id/cbInformative"
                android:layout_toRightOf="@id/cbFantasy"
                android:id="@+id/cbSciFi"
                android:text="Sci-Fi"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cbHorror"
                android:textColor="@color/white"
                android:layout_toRightOf="@id/cbSciFi"
                android:id="@+id/cbSuspense"
                android:text="Suspense"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_below="@id/cbDrama"
                android:layout_toRightOf="@id/cbSuspense"
                android:id="@+id/cbSelfHelp"
                android:text="SelfHelp"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cbFantasy"
                android:textColor="@color/white"
                android:id="@+id/cbPhilosophy"
                android:text="Philosophy"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_below="@id/cbSciFi"
                android:layout_toRightOf="@id/cbPhilosophy"
                android:id="@+id/cbFiction"
                android:text="Fiction"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_below="@id/cbSuspense"
                android:layout_toRightOf="@id/cbFiction"
                android:id="@+id/cbHistory"
                android:text="History"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cbSelfHelp"
                android:textColor="@color/white"
                android:layout_toRightOf="@id/cbHistory"
                android:id="@+id/cbPolitics"
                android:text="Politics"
                />
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cbPhilosophy"
                android:textColor="@color/white"
                android:id="@+id/cbTechnology"
                android:text="Technology"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Paid Book"
                android:textColor="@color/white"
                android:id="@+id/tvPaid"
                android:layout_below="@id/cbTechnology"
                android:layout_marginVertical="10dp"/>

            <ToggleButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/tvPaid"
               android:layout_below="@id/cbTechnology"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:backgroundTint="@color/olivegreen"
                android:id="@+id/btnPaid" />
        </RelativeLayout>



         <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No book attached"
             android:textSize="20sp"
             android:textColor="@color/white"
             android:layout_marginVertical="20dp"
        android:drawableRight="@drawable/ic_browse"
        android:id="@+id/tvBookFound"/>
<!--    <ProgressBar-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="10dp"-->
<!--        style="@style/Widget.AppCompat.ProgressBar.Horizontal"-->
<!--        android:id="@+id/pdfProgress"-->
<!--        android:progressDrawable="@drawable/progress_bg"-->
<!--        />-->
        <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/btnUploadBook"
        android:text="upload pdf"/>
        </LinearLayout>
</ScrollView>